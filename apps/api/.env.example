# Resend — quote email delivery (required for deploy)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM="OJ Auto Detailing <quotes@oj-auto-detailing.com.au>"

# CORS — extra allowed origin (site domains are always permitted per STAGE)
# prod → https://oj-auto-detailing.com.au
# dev  → https://dev.oj-auto-detailing.com.au
CLOUDFRONT_ORIGIN=https://oj-auto-detailing.com.au

# PostHog server-side events (optional)
POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://us.i.posthog.com
