# Gmail SMTP credentials for the Lambda quote handler.
# Copy this file to .env and fill in the real values for local development.
# In production, set these as Lambda environment variables (e.g. via AWS Console,
# SAM / Serverless Framework config, or your CI/CD pipeline).
#
# GMAIL_USER         — the Gmail address that sends the email (e.g. you@gmail.com)
# GMAIL_APP_PASSWORD — a Gmail App Password (not your main password).
#   Generate one at: https://myaccount.google.com/apppasswords
#   (Requires 2-Step Verification to be enabled on the account.)

GMAIL_USER=
GMAIL_APP_PASSWORD=
