meta {
  name: Submit Quote
  type: http
  seq: 1
  tags: [
    quote
    smoke
  ]
}

post {
  url: {{baseUrl}}/api/quote
  body: json
  auth: none
}

body:json {
  {
    "service": "complete-detail",
    "name": "Bruno Test",
    "phone": "0412345678",
    "email": "test@example.com",
    "suburb": "Epping",
    "vehicle_model": "Toyota Camry",
    "addons": [
      "water-repellent",
      "headlight-restoration"
    ],
    "notes": "Submitted from Bruno collection — safe to ignore.",
    "terms_accepted": true
  }
}

tests {
  test("returns 200 with success", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}

docs {
  Sends a full car quote request. In production this triggers a real email to the business inbox.
}
