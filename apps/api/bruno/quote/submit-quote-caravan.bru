meta {
  name: Submit Quote (Caravan)
  type: http
  seq: 2
  tags: [
    quote
  ]
}

post {
  url: {{baseUrl}}/api/quote
  body: json
  auth: none
}

body:json {
  {
    "vehicle_type": "caravan",
    "service": "tier-2-interior",
    "name": "Bruno Test",
    "phone": "0498765432",
    "email": "test@example.com",
    "vehicle_model": "Jayco Swan",
    "addons": [
      "trim-restoration"
    ],
    "terms_accepted": true
  }
}

tests {
  test("returns 200 with success", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}
