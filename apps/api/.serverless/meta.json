    "serviceRawFile": "# OJ Auto Detailing — API (AWS Lambda + API Gateway HTTP API)\n#\n# Prerequisites:\n#   1. AWS credentials configured (aws configure / IAM role)\n#   2. Export secrets before deploy:\n#        export RESEND_API_KEY=re_...\n#        export RESEND_FROM=\"OJ Auto Detailing <quotes@oj-auto-detailing.com.au>\"\n#        export CLOUDFRONT_ORIGIN=https://dxxxxxxxx.cloudfront.net\n#   3. Build the bundle: pnpm --filter @oj-detailing/api build\n#\n# Deploy:\n#   pnpm --filter @oj-detailing/api deploy\n#\n# Static site (apps/web):\n#   Build with `pnpm --filter @oj-detailing/web build`, then sync `apps/web/dist/`\n#   to an S3 bucket configured for static website hosting. Point CloudFront at the\n#   bucket and add a behavior so `/api/*` forwards to this API Gateway endpoint.\n\nservice: oj-detailing-api\n\nframeworkVersion: \"4\"\n\ncustom:\n  stage: ${opt:stage, 'prod'}\n  # Keep existing HTTP APIs (CloudFormation stacks were recreated against these IDs).\n  httpApiByStage:\n    prod:\n      id: cuvsx6p8fd\n    dev:\n      id: finqizix8b\n\nprovider:\n  name: aws\n  runtime: nodejs24.x\n  region: ap-southeast-2\n  stage: ${self:custom.stage}\n  memorySize: 256\n  timeout: 10\n  httpApi: ${self:custom.httpApiByStage.${self:custom.stage}}\n  iam:\n    role:\n      statements:\n        - Effect: Deny\n          Action:\n            - dynamodb:PutItem\n          Resource: !GetAtt QuotesTable.Arn\n            \n  environment:\n    NODE_ENV: production\n    STAGE: ${self:custom.stage}\n    RESEND_API_KEY: ${env:RESEND_API_KEY}\n    RESEND_FROM: ${env:RESEND_FROM}\n    CLOUDFRONT_ORIGIN: ${env:CLOUDFRONT_ORIGIN, 'https://oj-auto-detailing.com.au'}\n    POSTHOG_API_KEY: ${env:POSTHOG_API_KEY}\n    POSTHOG_HOST: ${env:POSTHOG_HOST}\n    QUOTES_TABLE: !Ref QuotesTable\n\nfunctions:\n  api:\n    handler: dist/lambda.handler\n    events:\n      # Catch-all for Express routes under /api/*\n      - httpApi:\n          path: /api/{proxy+}\n          method: ANY\n      - httpApi:\n          path: /api\n          method: ANY\n\npackage:\n  individually: true\n  patterns:\n    - \"!**\"\n    - \"dist/lambda.js\"\n    - \"dist/lambda.js.map\"\n\nresources:\n  Resources:\n    QuotesTable:\n      Type: AWS::DynamoDB::Table\n      Properties:\n        TableName: oj-detailing-quotes-${self:custom.stage}\n        BillingMode: PAY_PER_REQUEST\n        AttributeDefinitions:\n          - AttributeName: quoteId\n            AttributeType: S\n        KeySchema:\n          - AttributeName: quoteId\n            KeyType: HASH\n",
