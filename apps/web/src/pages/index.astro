---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="OJ Auto Detailing | Car Detailing Melbourne"
  description="Mobile car detailing in Melbourne, VIC."
  home={true}
  stylesheets={[
    '/css/animations.css',
    '/css/hero.css',
    '/css/services.css',
    '/css/recent-work.css',
    '/css/progress-slider.css',
    '/css/testimonial.css',
    '/css/quote.css',
  ]}
  scripts={['/js/split-type.min.js', '/js/lenis.min.js', '/js/script.js']}
>
  <main id="main">
<section class="hero" id="hero" aria-labelledby="hero-title">
      <img class="hero__bg" src="/images/merc-car.png" alt="" aria-hidden="true" draggable="false">
      <div class="hero__overlay" aria-hidden="true"></div>
      <div class="hero__content">
        <p class="hero__rating hero-in hero-in--1">
          <span class="stars" aria-hidden="true">★★★★★</span> 5.0 · Rated by Melbourne clients
        </p>

        <h1 class="hero__title hero-in hero-in--2" id="hero-title">Detailed to <span
            class="hero__title__accent">Perfection</span></h1>

        <p class="hero__sub hero-in hero-in--3">Quality interior and exterior detailing in Melbourne. We do the
          job properly, charge a fair price, and make booking easy.</p>

        <div class="hero__actions">
          <a href="#quote" class="btn btn-blue btn-blue-draw hero-in hero-in--4">Get A Free Quote</a>
          <a href="#recent-work" class="btn btn-ghost btn-ghost-draw hero-in hero-in--5">See Our Work</a>
        </div>
      </div>
    </section>

    <section class="recent-work" id="recent-work" aria-labelledby="recent-work-title">
      <div class="recent-work__inner">
        <header class="recent-work__header reveal">
          <h2 class="recent-work__title" id="recent-work-title">Recent Work</h2>
        </header>

        <div class="recent-work__grid">
          <article class="progress-slider reveal reveal-delay-1"
              data-label1="Where we started"
              data-label2="Better… but still grubby"
              data-label3="Way cleaner now"
              data-label4="OJ level cleaned"
              data-threshold2="0.25"
              data-threshold3="0.55"
              data-threshold4="0.85"
              aria-label="Kia cleaning progress reveal">

              <a href="#service-tier-2" class="work-badge" aria-label="See Tier 2 Interior package">Tier 2 Interior</a>

              <!-- ── Image stack ─────────────────────────────────────── -->
              <div class="progress-slider__frame">

                <!-- ① STAGE 0, dirtiest -->
                <img class="progress-slider__layer" src="/images/kia-before.png" alt="Kia before detail, dirtiest condition">

                <!-- ② STAGE 1, 33% clean -->
                <img class="progress-slider__layer" src="/images/kia-trans-thirty-three.png" alt="Kia detail stage 2, starting to clean">

                <!-- ③ STAGE 2, 66% clean -->
                <img class="progress-slider__layer" src="/images/kia-trans-sixty-six.png" alt="Kia detail stage 3, nearly there">

                <!-- ④ STAGE 3, fully detailed -->
                <img class="progress-slider__layer" src="/images/kia-after.png" alt="Kia after detail, OJ level clean">
              </div>

              <!-- ── Drag controls ────────────────────────────────────── -->
              <div class="progress-slider__controls">
                <p class="progress-slider__label" aria-live="polite">Where we started</p>
                <div class="progress-slider__track" aria-hidden="true">
                  <div class="progress-slider__fill"></div>
                  <button class="progress-slider__handle" type="button" role="slider" tabindex="0"
                    aria-label="Drag to reveal Kia cleaning progress" aria-valuemin="0" aria-valuemax="100"
                    aria-valuenow="0">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75"
                      stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="5,4 2,8 5,12" />
                      <polyline points="11,4 14,8 11,12" />
                    </svg>
                  </button>
                </div>
              </div>

            </article>

          <article class="work-card reveal reveal-delay-2">
            <a href="#service-tier-1" class="work-badge" aria-label="See Tier 1 Exterior package">Tier 1 Exterior</a>
            <div class="work-card__media" data-view="before">
              <div class="work-card__slot work-card__slot--before is-active">
                <img src="/images/raptor-before.png" alt="Ford Raptor before exterior detail">
              </div>
              <div class="work-card__slot work-card__slot--after">
                <img src="/images/raptor-after.png" alt="Ford Raptor after exterior detail">
              </div>
            </div>
            <div class="work-card__toggle" role="group" aria-label="Raptor exterior detail, before or after">
              <div class="work-card__toggle-inner">
                <button type="button" class="work-card__btn is-active" data-view="before"
                  aria-pressed="true">Before</button>
                <button type="button" class="work-card__btn" data-view="after" aria-pressed="false">After</button>
              </div>
            </div>
          </article>

          <article class="progress-slider reveal reveal-delay-3"
              data-label1="Where we started"
              data-label2="Better… but still grubby"
              data-label3="Way cleaner now"
              data-label4="OJ level cleaned"
              data-threshold2="0.25"
              data-threshold3="0.55"
              data-threshold4="0.85"
              aria-label="Skoda cleaning progress reveal">

              <a href="#service-tier-2" class="work-badge" aria-label="See Tier 2 Interior package">Tier 2 Interior</a>

              <!-- ── Image stack ─────────────────────────────────────── -->
              <div class="progress-slider__frame">

                <img class="progress-slider__layer" src="/images/skoda-before.png" alt="Skoda before detail, dirtiest condition">

                <img class="progress-slider__layer" src="/images/skoda-trans-thirty-three.png" alt="Skoda detail stage 2, starting to clean">

                <img class="progress-slider__layer" src="/images/skoda-trans-sixty-six.png" alt="Skoda detail stage 3, nearly there">

                <img class="progress-slider__layer" src="/images/skoda-after.png" alt="Skoda after detail, OJ level clean">
              </div>

              <!-- ── Drag controls ────────────────────────────────────── -->
              <div class="progress-slider__controls">
                <p class="progress-slider__label" aria-live="polite">Where we started</p>
                <div class="progress-slider__track" aria-hidden="true">
                  <div class="progress-slider__fill"></div>
                  <button class="progress-slider__handle" type="button" role="slider" tabindex="0"
                    aria-label="Drag to reveal Skoda cleaning progress" aria-valuemin="0" aria-valuemax="100"
                    aria-valuenow="0">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75"
                      stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="5,4 2,8 5,12" />
                      <polyline points="11,4 14,8 11,12" />
                    </svg>
                  </button>
                </div>
              </div>

            </article>

          <article class="progress-slider reveal reveal-delay-4"
              data-label1="Where we started"
              data-label2="Better… but still grubby"
              data-label3="Way cleaner now"
              data-label4="OJ level cleaned"
              data-threshold2="0.25"
              data-threshold3="0.55"
              data-threshold4="0.85"
              aria-label="GLC interior detail progress reveal">

              <a href="#service-tier-2" class="work-badge" aria-label="See Tier 2 Interior package">Tier 2 Interior</a>

              <!-- ── Image stack ─────────────────────────────────────── -->
              <div class="progress-slider__frame">

                <!-- ① STAGE 1, dirtiest -->
                <img class="progress-slider__layer" src="/images/glc-merc-before.png"
                  alt="GLC interior before detail, where we started">

                <!-- ② STAGE 2, mid dirty -->
                <img class="progress-slider__layer" src="/images/glc-merc-thirty-three.png"
                  alt="GLC interior detail stage 2, better but still grubby">

                <!-- ③ STAGE 3, nearly clean -->
                <img class="progress-slider__layer" src="/images/glc-merc-sixty-six.png"
                  alt="GLC interior detail stage 3, way cleaner now">

                <!-- ④ STAGE 4, fully detailed -->
                <img class="progress-slider__layer" src="/images/glc-merc-after.png"
                  alt="GLC interior after detail, OJ level cleaned">
              </div>

              <!-- ── Drag controls ────────────────────────────────────── -->
              <div class="progress-slider__controls">
                <p class="progress-slider__label" aria-live="polite">Where we started</p>
                <div class="progress-slider__track" aria-hidden="true">
                  <div class="progress-slider__fill"></div>
                  <button class="progress-slider__handle" type="button" role="slider" tabindex="0"
                    aria-label="Drag to reveal GLC interior detail progress" aria-valuemin="0"
                    aria-valuemax="100" aria-valuenow="0">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75"
                      stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="5,4 2,8 5,12" />
                      <polyline points="11,4 14,8 11,12" />
                    </svg>
                  </button>
                </div>
              </div>

            </article>
        </div>
      </div>
    </section>

    <section class="services" id="services" aria-labelledby="services-title" data-vehicle="car">
      <div class="services__inner">
        <header class="services__header reveal">
          <h2 class="services__title" id="services-title">Our Services</h2>
          <p class="services__sub">Pick the package that fits your car and schedule.</p>
        </header>

        <div class="services__toggle-wrap">
          <div class="vehicle-toggle" role="tablist" aria-label="Filter services by vehicle type">
            <button class="vehicle-toggle__btn btn btn-blue btn-blue-draw" role="tab" aria-selected="true" data-vehicle="car">Car</button>
            <button class="vehicle-toggle__btn btn btn-blue btn-blue-draw" role="tab" aria-selected="false" data-vehicle="caravan">Caravan</button>
          </div>
        </div>

        <div class="services__grid">
          <article class="service-card reveal reveal-delay-1" data-caravan-unavailable data-quote-service="touch-up">
            <h3 class="service-card__name">Touch Up</h3>
            <p class="service-card__tagline">Takes clean to perfect again.</p>
            <div class="service-card__meta">
              <div class="spec spec--lg">
                <span class="spec__label">From</span>
                <span class="spec__value">$80</span>
              </div>
            </div>
            <ul class="service-card__list">
              <li>Exterior clean</li>
              <li>Interior clean (vacuum + light steam clean)</li>
              <li>Scented accessories</li>
            </ul>
            <a href="https://ojautodetailing.setmore.com" class="service-card__link btn btn-blue btn-blue-draw"
              target="_blank" rel="noopener noreferrer">Book this →</a>
          </article>

          <article class="service-card reveal reveal-delay-2" id="service-tier-1" data-caravan-top data-quote-service="tier-1-exterior">
            <h3 class="service-card__name">Tier 1 Exterior</h3>
            <p class="service-card__tagline">Street presence, restored.</p>
            <div class="service-card__meta">
              <div class="spec spec--lg">
                <span class="spec__label">From</span>
                <span class="spec__value">$65</span>
                <span class="spec__qualifier">May vary by caravan size</span>
              </div>
            </div>
            <ul class="service-card__list">
              <li>Deep pressure wash</li>
              <li>Tyre acid clean</li>
              <li>Pre soak</li>
              <li>Foam cleanse</li>
              <li>Exterior windows cleaned</li>
              <li>Finishing shine touch</li>
            </ul>
            <a href="https://ojautodetailing.setmore.com" class="service-card__link btn btn-blue btn-blue-draw"
              target="_blank" rel="noopener noreferrer">Book this →</a>
          </article>

          <article class="service-card reveal reveal-delay-3" id="service-tier-2" data-quote-service="tier-2-interior">
            <h3 class="service-card__name">Tier 2 Interior</h3>
            <p class="service-card__tagline">Feels like the day you bought it.</p>
            <div class="service-card__meta">
              <div class="spec spec--lg">
                <span class="spec__label">From</span>
                <span class="spec__value">$150</span>
                <span class="spec__qualifier">May vary by caravan size</span>
              </div>
            </div>
            <ul class="service-card__list">
              <li>Heavy vacuum</li>
              <li>Rubbish collection</li>
              <li>Stain removal</li>
              <li>Screen + window cleanse</li>
              <li>Steam cleaning</li>
              <li>Car protectant</li>
              <li>Leather conditioning</li>
              <li>Panel cleaning</li>
              <li>Rail scrub</li>
              <li>Scented accessories</li>
            </ul>
            <a href="https://ojautodetailing.setmore.com" class="service-card__link btn btn-blue btn-blue-draw"
              target="_blank" rel="noopener noreferrer">Book this →</a>
          </article>

          <article class="service-card service-card--popular reveal reveal-delay-4" id="service-tier-3" data-quote-service="tier-3-complete">
            <span class="service-card__badge">Most Popular</span>
            <h3 class="service-card__name">Tier 3 Complete Detail</h3>
            <p class="service-card__tagline">The full works, inside and out.</p>
            <div class="service-card__meta">
              <div class="spec spec--lg">
                <span class="spec__label">From</span>
                <span class="spec__value">$200</span>
                <span class="spec__qualifier">May vary by caravan size</span>
              </div>
            </div>
            <ul class="service-card__list">
              <li class="service-card__list-item--tier">Everything in Tier 1 (full exterior detail)</li>
              <li class="service-card__list-item--tier">Everything in Tier 2 (full interior detail)</li>
              <li class="service-card__list-item--value" data-caravan-save="Save $25 vs. booking Tier 1 + Tier 2 separately">Save $15 vs. booking Tier 1 + Tier 2 separately</li>
            </ul>
            <a href="https://ojautodetailing.setmore.com" class="service-card__link btn btn-blue btn-blue-draw"
              target="_blank" rel="noopener noreferrer">Book this →</a>
          </article>
        </div>

        <!-- ── Add-ons & Extras collapsible panel ── -->
        <div class="addons">
          <button
            class="addons__trigger"
            type="button"
            aria-expanded="true"
            aria-controls="addons-panel"
            id="addons-trigger"
          >
            <span class="addons__trigger-label">Add ons &amp; Extras</span>
            <svg class="addons__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>

          <div
            class="addons__panel is-open"
            id="addons-panel"
            role="region"
            aria-labelledby="addons-trigger"
          >
            <ul class="addons__list">
              <li class="addon-chip">
                <div class="addon-chip__main">
                  <span class="addon-chip__name">Scratch removal</span>
                  <span class="addon-chip__price">FROM $45</span>
                </div>
                <p class="addon-chip__desc">Knock out light scratches</p>
              </li>
              <li class="addon-chip">
                <div class="addon-chip__main">
                  <span class="addon-chip__name">Trim restoration</span>
                  <span class="addon-chip__price">FROM $50</span>
                </div>
                <p class="addon-chip__desc">Bring faded trims and plastics back to life</p>
              </li>
              <li class="addon-chip">
                <div class="addon-chip__main">
                  <span class="addon-chip__name">Water repellent</span>
                  <span class="addon-chip__price">FROM $30</span>
                </div>
                <p class="addon-chip__desc">Rain beads run off glass for safer driving</p>
              </li>
              <li class="addon-chip">
                <div class="addon-chip__main">
                  <span class="addon-chip__name">Anti fog</span>
                  <span class="addon-chip__price">FROM $35</span>
                </div>
                <p class="addon-chip__desc">Remove fog from windows for safer driving</p>
              </li>
              <li class="addon-chip">
                <div class="addon-chip__main">
                  <span class="addon-chip__name">Headlight restoration</span>
                  <span class="addon-chip__price">FROM $100</span>
                </div>
                <p class="addon-chip__desc">Foggy, yellowed lenses restored to crystal clear, bringing your car many years back.</p>
              </li>
            </ul>
          </div>
        </div>

      </div>
    </section>

    <section class="testimonial" id="reviews" aria-labelledby="testimonial-title">
      <div class="testimonial__inner reveal">
        <h2 class="visually-hidden" id="testimonial-title">Client reviews</h2>

        <p class="review-section-header">
          Rated <strong class="review-section-header__score">5.0</strong>
          <span class="review-section-header__label">by Melbourne customers</span>
        </p>

        <div class="review-carousel" aria-roledescription="carousel" aria-label="Client reviews">
          <button class="review-carousel__arrow review-carousel__arrow--prev" type="button" aria-label="Previous review">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="15 18 9 12 15 6"/>
            </svg>
          </button>

          <div class="review-carousel__track" aria-live="polite" aria-atomic="true">
            <!-- Slides injected by JS -->
          </div>

          <button class="review-carousel__arrow review-carousel__arrow--next" type="button" aria-label="Next review">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </button>
        </div>

        <p class="review-carousel__hint" id="review-swipe-hint" aria-hidden="true">
          <span class="review-carousel__hint-arrows" aria-hidden="true">← →</span>
          Swipe to see more reviews
        </p>

        <div class="review-carousel__dots" role="group" aria-label="Review navigation">
          <!-- Dots injected by JS -->
        </div>
      </div>
    </section>

    <section class="quote" id="quote" aria-labelledby="quote-title">
      <div class="quote__inner">

        <header class="quote__header reveal">
          <h2 class="quote__title" id="quote-title">Get a Quote</h2>
          <p class="quote__sub">Build your detail and we'll send it to Julian. He confirms your final price.</p>
        </header>

        <form class="quote__body" name="quote" method="POST" novalidate>

          <!-- Honeypot: visually hidden, never filled by real users -->
          <input class="visually-hidden" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true">

          <!-- ── Left panel: configurator ── -->
          <div class="quote__config reveal reveal-delay-1">

            <!-- Vehicle type -->
            <div class="quote__field">
              <label class="quote__label" for="quote-vehicle">Vehicle type</label>
              <div class="quote__select-wrap">
                <select class="quote__select" id="quote-vehicle" name="vehicle_type">
                  <option value="car">Car</option>
                  <option value="caravan">Caravan</option>
                </select>
              </div>
            </div>

            <!-- Service -->
            <div class="quote__field">
              <label class="quote__label" for="quote-service">Service</label>
              <div class="quote__select-wrap">
                <select class="quote__select" id="quote-service" name="service">
                  <option value="" disabled selected>Select a service</option>
                  <!-- options populated once pricing is wired -->
                </select>
              </div>
            </div>

            <!-- Add-ons -->
            <fieldset class="quote__field quote__field--addons">
              <legend class="quote__label">Add ons <span class="quote__label-hint">(optional)</span></legend>
              <button type="button" class="quote__addons-clear btn btn-blue btn-blue-draw" id="quote-addons-clear" hidden>Clear</button>
              <div class="quote__checkboxes">
                <!-- Rendered from PRICING in script.js, edit prices there, not here -->
              </div>
            </fieldset>

            <!-- Estimate summary box, wired to pricing logic next -->
            <div class="quote__estimate" aria-live="polite" aria-label="Estimated price">
              <p class="quote__estimate-label">Estimated price</p>
              <p class="quote__estimate-value quote__estimate-value--placeholder">Select a service to see your estimate.</p>
              <p class="quote__estimate-note">Julian confirms your final price after reviewing your request.</p>
            </div>

          </div><!-- /.quote__config -->

          <!-- ── Right panel: personal details ── -->
          <div class="quote__details reveal reveal-delay-2">

            <div class="quote__field">
              <label class="quote__label" for="quote-name">Full name</label>
              <input class="quote__input" type="text" id="quote-name" name="name"
                placeholder="Jane Smith" autocomplete="name" required>
            </div>

            <div class="quote__field-row">
              <div class="quote__field">
                <label class="quote__label" for="quote-phone">Phone</label>
                <input class="quote__input" type="tel" id="quote-phone" name="phone"
                  placeholder="04xx xxx xxx" autocomplete="tel" required>
              </div>
              <div class="quote__field">
                <label class="quote__label" for="quote-email">Email</label>
                <input class="quote__input" type="email" id="quote-email" name="email"
                  placeholder="you@example.com" autocomplete="email" required>
              </div>
            </div>

            <div class="quote__field">
              <label class="quote__label" for="quote-vehicle-model">Vehicle make &amp; model</label>
              <input class="quote__input" type="text" id="quote-vehicle-model" name="vehicle_model"
                placeholder="e.g. Toyota Camry 2020">
            </div>

            <div class="quote__field">
              <label class="quote__label" for="quote-date">Preferred date</label>
              <div class="quote__date-wrap">
                <input class="quote__input quote__input--date" type="date" id="quote-date" name="preferred_date">
                <span class="quote__date-placeholder" aria-hidden="true">DD/MM/YYYY</span>
              </div>
            </div>

            <div class="quote__field">
              <label class="quote__label" for="quote-notes">Anything else</label>
              <textarea class="quote__input quote__textarea" id="quote-notes" name="notes" rows="4"
                placeholder="Any specific concerns, requests, or extra context..."></textarea>
            </div>

            <p class="quote__policy-note" id="quote-policy-note" hidden>
              <strong>Note:</strong> Late notice (up to 48 hours) incurs up to 30% extra of the appointment price. Any
              cancellations up to 48 hours prior to the scheduled appointment can cost up to 50% of the service fee.
            </p>

            <div class="quote__field quote__field--terms">
              <label class="quote__terms-label" for="quote-terms">
                <input class="quote__checkbox quote__terms-checkbox" type="checkbox" id="quote-terms"
                  name="terms_accepted" value="true" required>
                <span class="quote__checkbox-custom" aria-hidden="true"></span>
                <span class="quote__terms-text">I have read and agree to the
                  <a href="/terms.html" target="_blank" rel="noopener noreferrer"
                    onclick="event.stopPropagation()">OJ Auto Detailing Terms &amp; Conditions</a>.
                </span>
              </label>
            </div>

            <button type="submit" class="btn btn-blue quote__submit">Send my quote to Julian</button>

          </div><!-- /.quote__details -->

        </form>

      </div>
    </section>
  </main>
</BaseLayout>
