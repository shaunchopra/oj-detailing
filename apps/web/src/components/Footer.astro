---
import { Image } from 'astro:assets';
import ojLogo from '../assets/images/oj-logo.png';

interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
const prefix = home ? '' : '/';

const footerLink =
  'link-draw inline-flex min-h-11 items-center px-0 py-1 text-[0.9375rem] font-normal text-text-muted transition-colors duration-200 ease-out hover:text-text';
---

<footer class="relative z-[1] border-t border-hairline px-8 pb-7 pt-10 transition-[background-color,border-color] duration-300 ease-out max-md:px-5 max-md:pb-6 max-md:pt-8">
  <div
    class="mx-auto mb-8 grid max-w-content grid-cols-[1fr_auto_1fr] items-center gap-8 max-md:mb-5 max-md:grid-cols-1 max-md:gap-5 max-md:text-center"
  >
    <div class="flex flex-row flex-wrap items-center justify-self-start gap-3 max-md:justify-center max-md:justify-self-center">
      <a
        href={home ? '#' : '/'}
        class="flex items-center gap-2 hover:text-text focus-visible:rounded focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-text"
        aria-label="OJ Auto Detailing home"
      >
        <Image
          class="block size-[34px] shrink-0 rounded-[7px] object-cover transition-opacity duration-200 ease-out group-hover:opacity-[0.88]"
          src={ojLogo}
          alt="OJ Auto Detailing logo"
          width={34}
          height={34}
          densities={[1, 2]}
        />
        <div class="logo-wordmark text-[0.9375rem] leading-tight [&_span]:mt-px">
          OJ Auto
          <span>Detailing</span>
        </div>
      </a>

      <div class="flex items-center gap-2.5">
        <a
          href="https://instagram.com/ojautodetail"
          class="icon-link"
          aria-label="Instagram"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="2.25" y="2.25" width="19.5" height="19.5" rx="4.5" ry="4.5" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="12" cy="12" r="4.25" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="17.25" cy="6.75" r="0.75" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a
          href="https://www.tiktok.com/@ojautodetailing"
          class="icon-link"
          aria-label="OJ Auto Detailing on TikTok"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8.25 12a4.25 4.25 0 1 0 4.25 4.25V4.25a5.25 5.25 0 0 0 5.25 5.25"
            />
          </svg>
        </a>
        <a
          href="https://mail.google.com/mail/?view=cm&fs=1&to=ojdservice1@gmail.com"
          class="icon-link"
          aria-label="Email ojdservice1@gmail.com via Gmail"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
            />
          </svg>
        </a>
        <a href="tel:+61423967170" class="icon-link" aria-label="Call 0423 967 170">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"
            />
          </svg>
        </a>
      </div>
    </div>

    <nav class="justify-self-center" aria-label="Footer">
      <ul class="flex list-none flex-wrap justify-center gap-x-7 gap-y-3">
        <li><a href={`${prefix}#recent-work`} class={footerLink}>Recent Work</a></li>
        <li><a href={`${prefix}#services`} class={footerLink}>Services</a></li>
        <li><a href={`${prefix}#reviews`} class={footerLink}>Reviews</a></li>
        <li><a href={`${prefix}#quote`} class={footerLink}>Quote</a></li>
        <li>
          <button
            type="button"
            class="footer-about__trigger link-draw inline-flex min-h-11 cursor-pointer items-center gap-[0.35rem] border-none bg-transparent px-0 py-1 font-body text-[0.9375rem] font-normal text-text-muted transition-colors duration-200 ease-out hover:text-text aria-expanded:text-text"
            id="footer-about-trigger"
            aria-expanded="false"
            aria-controls="footer-about-panel"
          >
            <span>About Us</span>
            <svg
              class="footer-about__chevron size-3.5 shrink-0 text-text-muted transition-[transform,color] duration-300 ease-out aria-expanded:rotate-180 aria-expanded:text-accent"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>
        </li>
        <li><a href="/terms.html" class={footerLink}>Terms</a></li>
      </ul>
    </nav>
  </div>

  <div class="footer-about mx-auto -mt-3 mb-6 w-full max-w-content max-md:-mt-1 max-md:mb-5 max-md:text-center">
    <div
      class="footer-about__panel border-hairline"
      id="footer-about-panel"
      role="region"
      aria-labelledby="footer-about-trigger"
    >
      <div class="footer-about__content">
        <p class="max-w-[42rem] text-[0.9375rem] font-normal leading-[1.65] text-text-muted max-md:mx-auto max-md:max-w-full">
          No franchises, no hidden fees. Just a local detailer who takes real pride in getting it right. We offer
          competitive rates without cutting corners.
        </p>
      </div>
    </div>
  </div>

  <div class="mx-auto flex max-w-content items-center justify-between gap-6 border-t border-hairline pt-6 max-md:gap-3 max-md:pt-5">
    <p class="min-w-0 flex-1 text-left text-[0.8125rem] font-normal leading-normal text-text-faint">
      Copyright &copy; <span id="footer-year"></span> OJ Auto Detailing
      <span class="mx-3 inline-block align-baseline text-lg font-black leading-none text-text opacity-85" aria-hidden="true">&bull;</span>
      Developed by
      <a href="https://github.com/shaunchopra" class="link-draw relative font-bold text-text hover:text-text" target="_blank" rel="noopener noreferrer">Shaun Chopra</a>
    </p>
    <a
      href="https://github.com/shaunchopra"
      class="icon-link shrink-0"
      aria-label="Shaun Chopra on GitHub"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.2 2.398.097 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
        />
      </svg>
    </a>
  </div>
</footer>

<style>
  .footer-about__trigger[aria-expanded='true'] .footer-about__chevron {
    transform: rotate(180deg);
    color: var(--color-accent);
  }
</style>
