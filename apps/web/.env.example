# PostHog web analytics (injected at build time via Astro)
# Get your project token from PostHog → Project settings → Project API key
POSTHOG_PROJECT_TOKEN=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Use https://eu.i.posthog.com if your PostHog project is in the EU region
POSTHOG_API_HOST=https://us.i.posthog.com
# production | development — development builds are noindexed
SITE_ENV=production
